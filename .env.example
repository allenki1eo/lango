# Copy to .env.local. Never commit real values.

# AI assistant (OpenRouter, free tool-calling models). Without a key, Lango uses keyword search only.
OPENROUTER_API_KEY=
# Optional comma-separated override, best first (max 3 are sent). Defaults live in src/lib/ai/openrouter.ts.
AI_MODELS=
# Set to "false" to switch the assistant off and use keyword search only.
AI_ENABLED=true

# Canonical site URL for SEO (sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (later milestones: admin panel). Not needed for the JSON catalog.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=
