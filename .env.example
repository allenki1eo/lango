# Copy to .env.local. Only the database is needed for M0; the rest arrive with later milestones.

# Database. A local file works for development; use libsql://… with a token for Turso.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Auth (M2)
AUTH_SECRET=
AUTH_RESEND_KEY=
EMAIL_FROM=

# AI search (M3)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
AI_ENABLED=false

# Cron jobs (M5)
CRON_SECRET=

# Canonical site URL for SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000
